{
  "name": "pi-vlm-proxy",
  "version": "0.1.1",
  "description": "Generic vision proxy extension for pi: lets non-multimodal models (e.g. DeepSeek) delegate image analysis to ANY OpenAI-compatible multimodal model. Zero vendor hardcoding - a model is just baseUrl + apiKey + model id. Auto-hides itself when the main model already supports images.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vision",
    "multimodal",
    "image-analysis",
    "describe-image",
    "openai-compatible",
    "vlm"
  ],
  "license": "MIT",
  "author": "lawrence",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawrencewzen/pi-vlm-proxy.git"
  },
  "homepage": "https://github.com/lawrencewzen/pi-vlm-proxy#readme",
  "bugs": {
    "url": "https://github.com/lawrencewzen/pi-vlm-proxy/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./extensions/index.ts"
    }
  },
  "engines": {
    "node": ">=20.3"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/lawrencewzen/pi-vlm-proxy/main/assets/preview.png"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^26.1.2",
    "typebox": "*",
    "typescript": "^5.6.0"
  }
}
